<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
    <!--
      The shopping assistant talks AG-UI. AGUI.Client ships lib/netstandard2.0 and lib/net10.0, so it
      is usable from this WebAssembly project as well as from the interactive-Server host that shares
      it. Microsoft.Extensions.AI.Abstractions is named explicitly rather than taken transitively:
      AGUI.Client asks for 10.6.0 while the rest of the solution is on 10.9.0, and ChatMessage /
      ChatResponseUpdate appear directly in this project's own code.
    -->
    <PackageReference Include="AGUI.Client" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnosc.EShop.Client.Web.Contracts\Tnosc.EShop.Client.Web.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tnosc.EShop.Client.Web.Tests.Unit" />
  </ItemGroup>

</Project>
