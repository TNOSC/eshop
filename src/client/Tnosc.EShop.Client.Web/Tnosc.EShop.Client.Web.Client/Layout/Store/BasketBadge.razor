@namespace Tnosc.EShop.Client.Web.Client.Layout.Store
@implements IDisposable

<FluentCounterBadge Count="@BasketState.ItemCount" ShowZero="false">
    <AnchorContent>
        <FluentAnchorButton Href="/basket"
                             Appearance="ButtonAppearance.Transparent"
                             IconOnly="true"
                             Title="Basket">
            <FluentIcon Value="@(new Icons.Regular.Size20.Cart())" />
        </FluentAnchorButton>
    </AnchorContent>
</FluentCounterBadge>
