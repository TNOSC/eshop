@namespace Tnosc.EShop.Client.Web.Client.Layout.Store

<div class="eshop-hero @(Tall ? "tall" : "")">
    <div class="eshop-hero-image"></div>
    <div class="eshop-hero-content">
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p>@Subtitle</p>
        }
    </div>
</div>
