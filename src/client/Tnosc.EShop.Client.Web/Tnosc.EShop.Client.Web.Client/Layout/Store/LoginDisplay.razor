@namespace Tnosc.EShop.Client.Web.Client.Layout.Store

<AuthorizeView>
    <Authorized>
        <form method="post" action="bff/logout">
            <AntiforgeryToken />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Transparent">
                Sign out
            </FluentButton>
        </form>
    </Authorized>
    <NotAuthorized>
        <FluentAnchorButton Href="bff/login" Appearance="ButtonAppearance.Transparent">
            Sign in
        </FluentAnchorButton>
    </NotAuthorized>
</AuthorizeView>
