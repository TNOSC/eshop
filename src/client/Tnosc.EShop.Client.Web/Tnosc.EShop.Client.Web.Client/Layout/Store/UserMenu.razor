@namespace Tnosc.EShop.Client.Web.Client.Layout.Store

<AuthorizeView>
    <Authorized>
        <div class="eshop-dropdown">
            <span class="eshop-dropdown-button" aria-label="Account">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                    <circle cx="12" cy="8" r="3.75"/>
                    <path d="M4.5 20c1.2-3.6 4.2-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/>
                </svg>
            </span>
            <div class="eshop-dropdown-content">
                <a class="eshop-dropdown-item" href="/orders">My orders</a>
                <form class="eshop-dropdown-item" method="post" action="bff/logout">
                    <AntiforgeryToken />
                    <button type="submit">Sign out</button>
                </form>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="eshop-dropdown-button" href="bff/login" aria-label="Sign in">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                <circle cx="12" cy="8" r="3.75"/>
                <path d="M4.5 20c1.2-3.6 4.2-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/>
            </svg>
        </a>
    </NotAuthorized>
</AuthorizeView>
