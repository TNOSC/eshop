@namespace Tnosc.EShop.Client.Web.Client.Layout.Admin
@inherits LayoutComponentBase
@using Tnosc.EShop.Client.Web.Client.Layout.Store

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header" Sticky="true" Class="eshop-admin-header">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <FluentLayoutHamburger />
            <FluentAnchorButton Href="/admin" Appearance="ButtonAppearance.Transparent" Class="eshop-admin-brand">Tnosc EShop — Back office</FluentAnchorButton>
            <FluentSpacer />
            <ThemeToggle @rendermode="InteractiveAuto" />
            <UserMenu />
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Width="250px" Class="eshop-admin-rail">
        <AdminNav />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Padding="@Padding.All3">
        @Body
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <a class="dismiss" role="button" aria-label="Dismiss">✕</a>
</div>

<FluentProviders />
<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
