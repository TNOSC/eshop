@* Routes.Admin.Products *@
@page "/admin/products"
@rendermode InteractiveAuto
@attribute [Authorize(Policy = Permissions.Catalog.Write)]
@using Microsoft.AspNetCore.Authorization
@using Tnosc.EShop.Client.Web.Client.Features.Admin.Catalog.Components
@using Tnosc.EShop.Client.Web.Client.Features.Admin.Catalog.ViewModels
@using Tnosc.EShop.Client.Web.Client.Features.Shared
@using Tnosc.EShop.Client.Web.Client.Infrastructure.Auth.Authorization
@using Tnosc.EShop.Client.Web.Client.Infrastructure.Errors

<PageTitle>Products — Back office</PageTitle>

<PageHeader Title="Products" Subtitle="Manage the catalogue." />

<FluentButton IconStart="@(new Icons.Regular.Size20.Add())"
              Appearance="ButtonAppearance.Primary"
              Margin="Margin.Bottom3"
              OnClick="@OpenCreateDialogAsync">
    New product
</FluentButton>

<StatefulBoundary State="_state">
    @if (_problem is not null)
    {
        <ErrorPanel Message="@ErrorCodeMessages.Humanize(_problem)" />
    }

    <FluentDataGrid TGridItem="ProductRowViewModel"
                    @ref="_grid"
                    ItemsProvider="@_productsProvider"
                    Pagination="@_pagination"
                    ResizableColumns="true"
                    ShowHover="true">
        <ChildContent>
            <PropertyColumn Property="@(p => p.Sku)" Title="SKU" />
            <PropertyColumn Property="@(p => p.Name)" Title="Name" />
            <PropertyColumn Property="@(p => p.BrandName)" Title="Brand" />
            <PropertyColumn Property="@(p => p.CategoryName)" Title="Category" />
            <PropertyColumn Property="@(p => p.PriceAmount)" Title="Price" Format="N2" Align="DataGridCellAlignment.End" />
            <PropertyColumn Property="@(p => p.StockQuantity)" Title="Stock" Align="DataGridCellAlignment.End" />
            <TemplateColumn Title="Actions" Align="DataGridCellAlignment.End">
                <FluentButton Size="ButtonSize.Small"
                              IconStart="@(new Icons.Regular.Size20.Money())"
                              OnClick="@(() => OpenPriceDialogAsync(product: context))">
                    Price
                </FluentButton>
                <FluentButton Size="ButtonSize.Small"
                              IconStart="@(new Icons.Regular.Size20.BoxMultiple())"
                              OnClick="@(() => OpenStockDialogAsync(product: context))">
                    Stock
                </FluentButton>
                <FluentButton Size="ButtonSize.Small"
                              IconStart="@(new Icons.Regular.Size20.Image())"
                              OnClick="@(() => OpenImageDialogAsync(product: context))">
                    Image
                </FluentButton>
            </TemplateColumn>
        </ChildContent>
        <EmptyContent><FluentLabel>No products match the current filter.</FluentLabel></EmptyContent>
    </FluentDataGrid>

    <FluentPaginator State="@_pagination" />
</StatefulBoundary>
