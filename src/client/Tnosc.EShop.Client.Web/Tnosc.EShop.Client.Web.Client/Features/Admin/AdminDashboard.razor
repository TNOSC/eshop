@page "/admin"
@rendermode InteractiveAuto
@attribute [Authorize(Roles = "admin")]
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using Tnosc.EShop.Client.Web.Client.Features.Shared

<PageTitle>Back office — Tnosc EShop</PageTitle>

<PageHeader Title="Back office" Subtitle="Manage products and customers." />

<div class="eshop-admin-tiles">
    <a class="eshop-admin-tile" href="/admin/products">
        <span class="label">Products</span>
        <span class="value">@(_productCount?.ToString(provider: CultureInfo.InvariantCulture) ?? "—")</span>
    </a>
    <a class="eshop-admin-tile" href="/admin/customers">
        <span class="label">Customers</span>
        <span class="value">@(_customerCount?.ToString(provider: CultureInfo.InvariantCulture) ?? "—")</span>
    </a>
</div>
