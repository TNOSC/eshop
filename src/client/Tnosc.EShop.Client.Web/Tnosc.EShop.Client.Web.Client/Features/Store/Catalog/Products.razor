@page "/products"
@rendermode InteractiveAuto
@using Tnosc.EShop.Client.Web.Client.Features.Shared
@using Tnosc.EShop.Client.Web.Client.Infrastructure.Errors
@using Tnosc.EShop.Client.Web.Contracts.Catalog

<PageTitle>Catalogue — Tnosc EShop</PageTitle>

<PageHeader Title="Catalogue" Subtitle="Browse everything in the store." />

<ProductFilters Search="@Search"
                SearchChanged="@OnSearchChangedAsync"
                CategoryId="@CategoryId"
                CategoryIdChanged="@OnCategoryIdChangedAsync"
                Categories="@_categories" />

@if (_problem is not null)
{
    <ErrorPanel Message="@ErrorCodeMessages.Humanize(_problem)" />
}
else if (_isLoading)
{
    <FluentGrid Spacing="3">
        @for (int i = 0; i < PageSize; i++)
        {
            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
                <FluentSkeleton Height="220px" />
            </FluentGridItem>
        }
    </FluentGrid>
}
else if (_products.Count == 0)
{
    <PageHeader Title="No products found" Subtitle="Try a different search or category." />
}
else
{
    <FluentGrid Spacing="3">
        @foreach (ProductSummary product in _products)
        {
            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
                <ProductCard Product="@product" />
            </FluentGridItem>
        }
    </FluentGrid>

    <FluentPaginator State="@_pagination" CurrentPageIndexChanged="@OnPageIndexChangedAsync" />
}
