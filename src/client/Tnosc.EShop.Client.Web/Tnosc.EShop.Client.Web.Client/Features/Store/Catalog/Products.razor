@page "/"
@page "/products"
@rendermode InteractiveAuto
@using Tnosc.EShop.Client.Web.Client.Infrastructure.Errors
@using Tnosc.EShop.Client.Web.Client.Layout.Store
@using Tnosc.EShop.Client.Web.Contracts.Catalog

<PageTitle>Catalogue — Tnosc EShop</PageTitle>

<StoreHero Title="Catalogue" Subtitle="Browse everything in the store." />

<div class="eshop-page eshop-catalog">
    <ProductFilters Search="@Search"
                    SearchChanged="@OnSearchChangedAsync"
                    CategoryId="@CategoryId"
                    Categories="@_categories" />
    <div class="eshop-catalog-results">
        @if (_problem is not null)
        {
            <ErrorPanel Message="@ErrorCodeMessages.Humanize(_problem)" />
        }
        else if (_isLoading)
        {
            <div class="eshop-catalog-items">
                @for (int i = 0; i < PageSize; i++)
                {
                    <div class="eshop-card eshop-card-skeleton">
                        <FluentSkeleton Height="220px" />
                    </div>
                }
            </div>
        }
        else if (_products.Count == 0)
        {
            <p class="eshop-catalog-empty">No products found. Try a different search or category.</p>
        }
        else
        {
            <div class="eshop-catalog-items">
                @foreach (ProductSummary product in _products)
                {
                    <ProductCard Product="@product" />
                }
            </div>

            <div class="eshop-pages">
                @for (int i = 0; i < _pagination.LastPageIndex + 1; i++)
                {
                    int pageIndex = i;
                    <a class="@(pageIndex == _pagination.CurrentPageIndex ? "active" : "")"
                       href="@PageUri(pageIndex)">@(pageIndex + 1)</a>
                }
            </div>
        }
    </div>
</div>
