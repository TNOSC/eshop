@namespace Tnosc.EShop.Client.Web.Client.Features.Store.Catalog
@using Tnosc.EShop.Client.Web.Contracts.Catalog

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true">
    <FluentTextInput TextInputType="TextInputType.Search"
                      Label="Search"
                      Placeholder="Search products…"
                      Immediate="true"
                      ImmediateDelay="300"
                      Value="@Search"
                      ValueChanged="@SearchChanged" />

    <FluentSelect TOption="Category"
                  TValue="Guid?"
                  Label="Category"
                  Placeholder="All categories"
                  Items="@Categories"
                  OptionText="@(category => category.Name)"
                  OptionValue="@(category => (Guid?)category.Id)"
                  Value="@CategoryId"
                  ValueChanged="@CategoryIdChanged" />
</FluentStack>

@code {
    [Parameter]
    [EditorRequired]
    public string? Search { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback<string?> SearchChanged { get; set; }

    [Parameter]
    [EditorRequired]
    public Guid? CategoryId { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback<Guid?> CategoryIdChanged { get; set; }

    [Parameter]
    [EditorRequired]
    public IReadOnlyList<Category> Categories { get; set; } = [];
}
