@namespace Tnosc.EShop.Client.Web.Client.Features.Store.Assistant.Components
@using Tnosc.EShop.Client.Web.Client.Features.Store.Catalog.Components
@using Tnosc.EShop.Client.Web.Client.Features.Store.Catalog.ViewModels

@* Presentational only: no Contracts DTO reaches it, so this component owns no view model and no
   service of its own — Products is the same display view model ProductCard already takes. *@

<div class="eshop-chat-bubble @(IsFromShopper ? "shopper" : "assistant")">
    @if (IsLookingUp)
    {
        <span class="eshop-chat-looking-up">
            <FluentSpinner />
            Looking up products…
        </span>
    }
    else
    {
        <p>@Text</p>

        @if (Products.Count > 0)
        {
            <div class="eshop-chat-products">
                @foreach (ProductSummaryViewModel product in Products)
                {
                    <ProductCard Product="product"
                                 ShowAddToBasket="true"
                                 OnAddToBasket="OnAddToBasket" />
                }
            </div>
        }
    }
</div>
