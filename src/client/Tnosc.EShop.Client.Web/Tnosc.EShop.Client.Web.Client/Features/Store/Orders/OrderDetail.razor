@page "/orders/{Id:guid}"
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Tnosc.EShop.Client.Web.Client.Features.Shared
@using Tnosc.EShop.Client.Web.Client.Infrastructure.Errors
@using Tnosc.EShop.Client.Web.Client.Features.Store.Checkout
@using Tnosc.EShop.Client.Web.Contracts.Ordering
@using Tnosc.EShop.Client.Web.Client.Layout.Store

<PageTitle>@(_order?.OrderNumber ?? "Order") — Tnosc EShop</PageTitle>

@if (Placed == true)
{
    <OrderPlaced />
}

@if (_problem is not null)
{
    <StoreHero Title="Order" />
    <div class="eshop-page">
        <ErrorPanel Message="@ErrorCodeMessages.Humanize(_problem)" />
    </div>
}
else if (_isLoading || _order is null)
{
    <StoreHero Title="Order" />
    <div class="eshop-page">
        <LoadingPanel />
    </div>
}
else
{
    <StoreHero Title="@($"Order {_order.OrderNumber}")" />

    <div class="eshop-page">
    <div class="eshop-checkout">
        <div class="eshop-order-status">
            <OrderStatusPill Status="@_order.Status" />
            <span>Placed @_order.PlacedOnUtc.ToLocalTime()</span>
        </div>

        <section class="eshop-form-section">
            <h2 class="eshop-h2">Delivery address</h2>
            <p>@_order.ShippingStreet</p>
            <p>@_order.ShippingPostalCode @_order.ShippingCity, @_order.ShippingCountry</p>
        </section>

        <section class="eshop-form-section">
            <h2 class="eshop-h2">Items</h2>
            @foreach (OrderLine line in _order.Lines)
            {
                <div class="eshop-checkout-line">
                    <span>@line.ProductName (@line.Sku) × @line.Quantity</span>
                    <MoneyDisplay Amount="@line.LineTotalAmount" Currency="@line.UnitPriceCurrency" />
                </div>
            }
            <div class="eshop-checkout-line total">
                <span>Total</span>
                <MoneyDisplay Amount="@_order.TotalAmount" Currency="@_order.TotalCurrency" />
            </div>
        </section>

        <div class="eshop-form-buttons">
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@CancelOrderAsync">Cancel</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@ConfirmOrderAsync">Confirm</FluentButton>
        </div>
    </div>
    </div>
}
