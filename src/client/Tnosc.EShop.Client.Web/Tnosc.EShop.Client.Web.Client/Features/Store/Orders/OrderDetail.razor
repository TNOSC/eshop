@page "/orders/{Id:guid}"
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Tnosc.EShop.Client.Web.Client.Features.Shared
@using Tnosc.EShop.Client.Web.Client.Features.Store.Checkout
@using Tnosc.EShop.Client.Web.Client.Infrastructure.Errors
@using Tnosc.EShop.Client.Web.Contracts.Ordering

<PageTitle>@(_order?.OrderNumber ?? "Order") — Tnosc EShop</PageTitle>

@if (Placed == true)
{
    <OrderPlaced />
}

@if (_problem is not null)
{
    <ErrorPanel Message="@ErrorCodeMessages.Humanize(_problem)" />
}
else if (_isLoading || _order is null)
{
    <LoadingPanel />
}
else
{
    <PageHeader Title="@($"Order {_order.OrderNumber}")" />

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
        <FluentBadge>@_order.Status</FluentBadge>
        <FluentText>Placed @_order.PlacedOnUtc.ToLocalTime()</FluentText>
    </FluentStack>

    <FluentCard Margin="Margin.Top3">
        <FluentText Weight="TextWeight.Semibold">Delivery address</FluentText>
        <FluentText>@_order.ShippingStreet</FluentText>
        <FluentText>@_order.ShippingPostalCode @_order.ShippingCity, @_order.ShippingCountry</FluentText>
    </FluentCard>

    <FluentCard Margin="Margin.Top3">
        <FluentText Weight="TextWeight.Semibold">Lines</FluentText>
        @foreach (OrderLine line in _order.Lines)
        {
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                <FluentText>@line.ProductName (@line.Sku) × @line.Quantity</FluentText>
                <MoneyDisplay Amount="@line.LineTotalAmount" Currency="@line.UnitPriceCurrency" />
            </FluentStack>
        }
        <FluentDivider />
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
            <FluentText Weight="TextWeight.Semibold">Total</FluentText>
            <MoneyDisplay Amount="@_order.TotalAmount" Currency="@_order.TotalCurrency" />
        </FluentStack>
    </FluentCard>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Margin="Margin.Top3">
        <FluentButton OnClick="@ConfirmOrderAsync">Confirm</FluentButton>
        <FluentButton OnClick="@CancelOrderAsync">Cancel</FluentButton>
    </FluentStack>
}
