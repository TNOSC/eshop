@page "/basket"
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Tnosc.EShop.Client.Web.Client.Features.Shared
@using Tnosc.EShop.Client.Web.Client.Infrastructure.Errors
@using Tnosc.EShop.Client.Web.Contracts.Basket

<PageTitle>Basket — Tnosc EShop</PageTitle>

<PageHeader Title="Your basket" />

@if (_problem is not null)
{
    <ErrorPanel Message="@ErrorCodeMessages.Humanize(_problem)" />
}
else if (_isLoading || _basket is null)
{
    <LoadingPanel />
}
else if (_basket.Items.Count == 0)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Margin="Margin.Top4">
        <FluentText>Your basket is empty.</FluentText>
        <FluentAnchorButton Href="/products" Appearance="ButtonAppearance.Primary">Browse products</FluentAnchorButton>
    </FluentStack>
}
else
{
    <FluentDataGrid TGridItem="BasketItem" Items="@_basket.Items.AsQueryable()" ResizableColumns="true" ShowHover="true">
        <ChildContent>
            <PropertyColumn Property="@(i => i.Sku)" Title="SKU" />
            <PropertyColumn Property="@(i => i.ProductName)" Title="Product" />
            <TemplateColumn Title="Unit price" Align="DataGridCellAlignment.End">
                <MoneyDisplay Amount="@context.UnitPriceAmount" Currency="@context.UnitPriceCurrency" />
            </TemplateColumn>
            <TemplateColumn Title="Quantity / Total" Align="DataGridCellAlignment.End">
                <BasketLineRow Item="@context"
                               QuantityChanged="@(quantity => ChangeQuantityAsync(item: context, quantity: quantity))"
                               Remove="@(() => RemoveItemAsync(item: context))" />
            </TemplateColumn>
        </ChildContent>
    </FluentDataGrid>

    <FluentStack Orientation="Orientation.Horizontal"
                 HorizontalAlignment="HorizontalAlignment.End"
                 VerticalAlignment="VerticalAlignment.Center"
                 HorizontalGap="16"
                 Margin="Margin.Top4">
        @if (_basket.TotalAmount is { } totalAmount && _basket.TotalCurrency is { } totalCurrency)
        {
            <FluentText Weight="TextWeight.Semibold">
                Total: <MoneyDisplay Amount="@totalAmount" Currency="@totalCurrency" />
            </FluentText>
        }
        <FluentAnchorButton Href="/checkout" Appearance="ButtonAppearance.Primary">Checkout</FluentAnchorButton>
    </FluentStack>
}
