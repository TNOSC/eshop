@page "/basket"
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Tnosc.EShop.Client.Web.Client.Features.Shared
@using Tnosc.EShop.Client.Web.Client.Infrastructure.Errors
@using Tnosc.EShop.Client.Web.Contracts.Basket
@using Tnosc.EShop.Client.Web.Client.Layout.Store

<PageTitle>Basket — Tnosc EShop</PageTitle>

<StoreHero Title="Your shopping bag" />

<div class="eshop-page">
@if (_problem is not null)
{
    <ErrorPanel Message="@ErrorCodeMessages.Humanize(_problem)" />
}
else if (_isLoading || _basket is null)
{
    <LoadingPanel />
}
else if (_basket.Items.Count == 0)
{
    <p>Your shopping bag is empty. <a href="/products">Continue shopping.</a></p>
}
else
{
    <div class="eshop-cart">
        <div class="eshop-cart-items">
            <div class="eshop-cart-header">
                <div class="eshop-cart-info">Products</div>
                <div class="eshop-cart-qty">Quantity</div>
                <div class="eshop-cart-total">Total</div>
            </div>

            @foreach (BasketItem item in _basket.Items)
            {
                <BasketLineRow Item="@item"
                               QuantityChanged="@(quantity => ChangeQuantityAsync(item: item, quantity: quantity))"
                               Remove="@(() => RemoveItemAsync(item: item))"
                               @key="item.Sku" />
            }
        </div>

        <aside class="eshop-cart-summary">
            <div class="eshop-cart-summary-inner">
                <div class="eshop-cart-summary-header">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Cart())" />
                    Your shopping bag
                    <span class="eshop-cart-count">@_basket.Items.Count</span>
                </div>
                @if (_basket.TotalAmount is { } totalAmount && _basket.TotalCurrency is { } totalCurrency)
                {
                    <div class="eshop-cart-summary-total">
                        <div>Total</div>
                        <div><MoneyDisplay Amount="@totalAmount" Currency="@totalCurrency" /></div>
                    </div>
                }
                <a class="eshop-button eshop-button-primary" href="/checkout">Check out</a>
                <a class="eshop-cart-summary-link" href="/products">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowLeft())" />
                    Continue shopping
                </a>
            </div>
        </aside>
    </div>
}
</div>
