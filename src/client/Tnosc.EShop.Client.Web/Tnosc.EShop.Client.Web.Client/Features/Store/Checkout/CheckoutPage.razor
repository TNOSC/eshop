@page "/checkout"
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Tnosc.EShop.Client.Web.Client.Features.Shared
@using Tnosc.EShop.Client.Web.Client.Infrastructure.Errors
@using Tnosc.EShop.Client.Web.Contracts.Basket

<PageTitle>Checkout — Tnosc EShop</PageTitle>

<PageHeader Title="Checkout" />

@if (_problem is not null)
{
    <ErrorPanel Message="@ErrorCodeMessages.Humanize(_problem)" />
}
else if (_isLoading || _basket is null || _customer is null)
{
    <LoadingPanel />
}
else if (_basket.Items.Count == 0)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Margin="Margin.Top4">
        <FluentText>Your basket is empty — there is nothing to check out.</FluentText>
        <FluentAnchorButton Href="/products" Appearance="ButtonAppearance.Primary">Browse products</FluentAnchorButton>
    </FluentStack>
}
else if (_customer.DefaultAddressId is null)
{
    <FluentText>You need a default delivery address before you can place an order. Contact support to have one added.</FluentText>
}
else
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentCard>
            <FluentText Weight="TextWeight.Semibold">Delivery address</FluentText>
            @{
                var address = _customer.Addresses.First(a => a.Id == _customer.DefaultAddressId);
            }
            <FluentText>@address.Street</FluentText>
            <FluentText>@address.PostalCode @address.City, @address.Country</FluentText>
        </FluentCard>

        <FluentCard>
            <FluentText Weight="TextWeight.Semibold">Items</FluentText>
            @foreach (BasketItem item in _basket.Items)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                    <FluentText>@item.ProductName × @item.Quantity</FluentText>
                    <MoneyDisplay Amount="@(item.UnitPriceAmount * item.Quantity)" Currency="@item.UnitPriceCurrency" />
                </FluentStack>
            }
            @if (_basket.TotalAmount is { } totalAmount && _basket.TotalCurrency is { } totalCurrency)
            {
                <FluentDivider />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                    <FluentText Weight="TextWeight.Semibold">Total</FluentText>
                    <MoneyDisplay Amount="@totalAmount" Currency="@totalCurrency" />
                </FluentStack>
            }
        </FluentCard>

        <FluentButton Appearance="ButtonAppearance.Primary"
                      Loading="@_isPlacingOrder"
                      Disabled="@_isPlacingOrder"
                      OnClick="@PlaceOrderAsync">
            Place order
        </FluentButton>
    </FluentStack>
}
