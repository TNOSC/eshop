<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Tnosc.EShop.Client.Web.styles.css"]" />
    <link href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="_content/Microsoft.FluentUI.AspNetCore.Components/css/default-fuib.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveAuto" />
    <!-- Manual include so the FluentUI web-components script is present under static SSR (e.g. Home.razor), not just on interactive pages. -->
    <script src="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js" type="module" async></script>
</head>

<body>
    @* No rendermode here: Routes.razor lives in this Server project, which is never shipped to the
       WASM bundle, so an interactive mode on Routes itself fails at runtime once WebAssembly is
       chosen ("Root component type ... could not be found"). Each routable page in .Client instead
       declares its own rendermode. *@
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
