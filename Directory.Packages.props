<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.McpInspector" Version="13.4.1-beta.706" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <!-- WASM has no shared framework, so AuthorizeView/CascadingAuthenticationState need this explicitly. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.11" />
    <!-- Same reason: Tnosc.Lib.Web's permission-authorization pieces must stay WASM-referenceable, so
         they take this package explicitly rather than the FrameworkReference Tnosc.Lib.Host uses. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.11" />
    <!-- Same reason: Tnosc.Lib.Web's BFF-facing HttpRequest/HttpResponse types (e.g. SameOriginRequirement). -->
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <!-- Unlike Cookies/JwtBearer, OpenIdConnect auth is NOT part of the Microsoft.AspNetCore.App shared
         framework — Tnosc.Lib.Web.Bff needs it as an explicit package even with a FrameworkReference. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <!--
      v5 is a prerelease (no stable build targets net10.0 yet), matching this solution's TFM;
      pin the exact version so restore does not silently drift across prerelease builds.
    -->
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0-rc.5-26219.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.0-rc.5-26219.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.10.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.173" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.32.0.713" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.16.1" />
    <PackageVersion Include="xunit.analyzers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.0" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.5.0" />
    <!--
      The two Keycloak integrations ship no stable build on any Aspire train — every published
      version carries a -preview suffix — so they cannot be pinned to a bare "13.4.6" the way the
      Postgres integrations above are. These are the 13.4.6 builds, same release, same day.
    -->
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.5.0-preview.1.26417.10" />
    <PackageVersion Include="Aspire.Keycloak.Authentication" Version="13.5.0-preview.1.26417.10" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.0" />
    <!-- Package id is "Aspire.StackExchange.Redis" (dotted) — "Aspire.StackExchangeRedis" does not exist. -->
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.5.0" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.5.0" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.12.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <!--
      A Web SDK project (Server.Host) gets .ValidateDataAnnotations() for free from the ASP.NET Core
      shared framework on net10.0, and an explicit PackageVersion there fails restore with NU1510
      (warnings are errors). A plain SDK project has no such shared framework, so
      Server.Infrastructure.External — the first non-Web project to validate an Options class — needs
      the package explicitly. Referenced only from that one project's .csproj.
    -->
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!--
      Must equal the Aspire.AppHost.Sdk version in aspire/Tnosc.EShop.AppHost.csproj (13.5.0). The
      testing package boots the very same AppHost the SDK builds, so a version skew between the two
      fails at run time rather than at restore. This is also why T8's integration suite used
      Testcontainers instead of booting the distributed app: there, the app is not the unit under test.
    -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <!--
      Transitive pin, not a package this solution uses directly. Testcontainers 4.12.0 pulls SSH.NET
      2025.1.0, which GHSA-q939-rpr3-3284 (high, arbitrary file write via ScpClient recursive
      download) covers for "<= 2025.1.0"; NU1903 is an error here, so it fails the build. 2026.0.0 is
      the patched release. Drop this line once Testcontainers ships a version that requires it itself.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
  </ItemGroup>
</Project>