{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "matcher": "^(write|create|edit|str_replace|str_replace_editor)$",
        "bash": "bash .github/hooks/posttooluse-csharp-conventions.sh",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash .github/hooks/agentstop-build-reminder.sh",
        "timeoutSec": 900
      }
    ]
  }
}
