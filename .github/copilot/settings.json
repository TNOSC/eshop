{
  "permissions": {
    "allow": [
      "Shell(dotnet build:*)",
      "Shell(dotnet test:*)",
      "Shell(dotnet format:*)",
      "Shell(dotnet ef migrations list:*)",
      "Shell(git status)",
      "Shell(git diff:*)",
      "Shell(git log:*)",
      "serena"
    ],
    "deny": [
      "Shell(git push:*)",
      "Write(.env)",
      "Write(.env.local)"
    ]
  },
  "deniedPaths": [
    "**/.env",
    "**/.env.local",
    "**/*.pfx"
  ]
}
